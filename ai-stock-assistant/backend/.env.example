# ─── LLM ───
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# LLM 计费（人民币 / 每百万 token，按服务商官网价格填写）
LLM_INPUT_PRICE_PER_1M=1.0
LLM_INPUT_CACHE_HIT_PRICE_PER_1M=0.02
LLM_OUTPUT_PRICE_PER_1M=2.0

# ─── 低价股筛选（小本金默认开启，后期可改 false）───
LOW_PRICE_MODE=true
MAX_STOCK_PRICE=30
MIN_STOCK_PRICE=2.0

# ─── 规则引擎权重（可选覆盖）───
RULE_W_CLOSE_MA20=20
RULE_W_MA20_MA60=10
RULE_W_RSI=15
RULE_W_MACD=15
RULE_W_VOLUME=5

# ─── 大盘环境检测 ───
MARKET_INDEX_CODE=000001
MARKET_MA_DAYS=60
MARKET_BEARISH_THRESHOLD=-5.0
MARKET_SUITABLE_THRESHOLD=65
MARKET_CAUTIOUS_THRESHOLD=40

# ─── 全量扫描 / 推荐预算 ───
FULL_SCAN_MAX_WORKERS=12
FULL_SCAN_MIN_CANDIDATES=200
RECOMMENDATION_MAX_CANDIDATES=10
RECOMMENDATION_MAX_PRESCREEN=80
RECOMMENDATION_MAX_WORKERS=3
RECOMMENDATION_RUN_TIMEOUT_SECONDS=300

# ─── 基本面 ───
FUNDAMENTAL_ENABLED=true

# ─── 新闻抓取 ───
NEWS_EM_LIMIT=5
NEWS_NOTICE_LIMIT=3
NEWS_NOTICE_DAYS=30
NEWS_MAX_DAYS=7
NEWS_FETCH_EM=true
NEWS_FETCH_SINA=true
NEWS_SUMMARY_MAX_CHARS=1200

# ─── 通知 ───
SERVER_CHAN_KEY=your-serverchan-key-here
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ─── App ───
API_HOST=0.0.0.0
API_PORT=8000

# ─── API 鉴权（可选）───
# 设置后，写操作/烧钱接口需携带 X-API-Key 请求头；不设置则鉴权关闭（默认，向后兼容）
# 前端需同步设置 NEXT_PUBLIC_API_KEY 为相同值
API_KEY=
